---
// Static fallback for the search forms: with JavaScript it shows the results for ?q=; without it,
// every page is listed so nothing is out of reach.
import Page from '../layouts/Page.astro';
import SearchBox from '../components/SearchBox.astro';
import { byGroup } from '../lib/docs';
---
<Page title="Search — GitLoom" description="Search the GitLoom docs and support answers." path="/search/" noindex>
<section class="pagehead cream"><div class="wrap">
  <p class="eyebrow">Search</p><h1>Search</h1>
  <div style="margin-top: 32px"><SearchBox id="pq" label="Search the site" /></div>
</div></section>
<section class="sec cream" style="padding-top: 16px"><div class="wrap" style="max-width: 900px; margin: 0 auto">
  <div data-results hidden><h2 class="sm" style="margin-bottom: 20px" data-results-title></h2><ul class="hits" data-hits></ul></div>
  <div data-all>
    <h2 class="sm" style="margin-bottom: 20px">All pages</h2>
    <div class="index">
      <section><h3>Site</h3><ul><li><a href="/download/">Download</a></li><li><a href="/support/">Support</a></li><li><a href="/changelog/">Changelog</a></li><li><a href="/compare/">Compare</a></li><li><a href="/press/">Press kit</a></li><li><a href="/privacy/">Privacy</a></li><li><a href="/terms/">Terms</a></li><li><a href="/security/">Security</a></li></ul></section>
      {byGroup.map((g) => <section><h3>{g.group}</h3><ul>{g.items.map((d) => <li><a href={d.url}>{d.title}</a></li>)}</ul></section>)}
    </div>
  </div>
</div></section>
</Page>

<script>
  import { loadIndex, search } from '../scripts/search';
  const q = new URLSearchParams(location.search).get('q')?.trim() ?? '';
  const input = document.querySelector<HTMLInputElement>('#pq');
  if (input) input.value = q;
  if (q) {
    loadIndex().then((entries) => {
      const hits = search(entries, q, 30);
      const box = document.querySelector<HTMLElement>('[data-results]')!;
      const title = box.querySelector('[data-results-title]')!;
      const list = box.querySelector('[data-hits]')!;
      title.textContent = hits.length ? `Results for “${q}”` : `Nothing matches “${q}”`;
      list.replaceChildren(...hits.map((h) => {
        const li = document.createElement('li');
        const a = document.createElement('a'); a.href = h.u;
        const b = document.createElement('b'); b.textContent = h.t;
        const g = document.createElement('span'); g.textContent = h.g;
        const p = document.createElement('p'); p.textContent = h.s;
        a.append(b, g); li.append(a, p); return li;
      }));
      if (!hits.length) {
        const li = document.createElement('li');
        li.innerHTML = 'Try fewer words, or <a href="https://github.com/Jarvis219/gitloom-site/issues">ask on GitHub Issues</a>.';
        list.append(li);
      }
      box.hidden = false;
      document.title = `${title.textContent} — GitLoom`;
    });
  }
</script>
