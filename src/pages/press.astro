---
import Page from '../layouts/Page.astro';
import { getReleases, formatDate } from '../lib/releases';

const releases = await getReleases();
const latest = releases.find((r) => !r.beta) ?? releases[0];
const descs = [
  ['One line', 'GitLoom is a free, native Git client for macOS.'],
  ['Short · 45 words', 'GitLoom is a free, native Git client for macOS, built with Swift and AppKit rather than Electron. Drag one branch onto another to merge, rebase or cherry-pick, stage single lines, and undo commits, checkouts and merges. It’s a 42 MB download for Apple silicon Macs.'],
  ['Long · 100 words', 'GitLoom is a free, native Git client for macOS, built with Swift and AppKit rather than Electron. It shows the first rows of a 100,000-commit repository in about 0.15 seconds and the full history in about 0.7 seconds. Drag one branch onto another to merge, rebase or cherry-pick, stage single lines, and undo commits, checkouts, merges and resets. It includes a three-way conflict editor, file history that follows renames, profiles with their own identity and SSH keys, and GitHub and GitLab pull requests, issues and Actions. It needs no account and sends no telemetry. It runs on macOS 14 or later on Apple silicon.'],
];
const shots = [['graph', 'Commit graph'], ['diff', 'Line staging'], ['conflict', 'Conflict editor'], ['actions', 'Pull requests and Actions']];
const colours = [
  ['Amber', '#F6B17A', 'Buttons and highlights'], ['Burnt', '#B94C1E', 'Bands, accents'], ['Ink', '#16161A', 'Text'],
  ['Cream', '#FBF4E8', 'Page'], ['Cream deep', '#F3E6D0', 'Panels'], ['On burnt', '#FFF8EE', 'Text on burnt'],
  ['Muted', '#5C5148', 'Secondary text'], ['Hairline', '#E7D9C2', 'Dividers'], ['Dark', '#14110E', 'Dark page'], ['Dark ink', '#F5EDE2', 'Dark text'],
];
const facts: [string, string][] = [
  ['Name', 'GitLoom'], ['What it is', 'A free, native Git client for macOS'], ['Built with', 'Swift and AppKit, not Electron'],
  ['Requirements', 'macOS 14 or later, Apple silicon'], ['Download size', '42 MB'], ['Price', 'Free'],
  ['Account', 'None needed. No telemetry.'], ['Languages', '16'], ['Hosting', 'GitHub and GitLab'],
];
const dl = '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v9M4 7.5l4 4 4-4M2.5 14h11"></path></svg>';
---
<Page title="GitLoom press kit — descriptions, icon, screenshots and facts" description="Descriptions of GitLoom in one line, 45 and 100 words, the app icon, light and dark screenshots, brand colours and a fact sheet, ready to use." path="/press/">
<section class="pagehead cream"><div class="wrap">
  <p class="eyebrow">Press</p><h1>Press kit</h1>
  <p class="lead">Descriptions, the icon, screenshots and facts you can use as they are.</p>
</div></section>
<section class="sec cream" style="padding-top: 16px" aria-labelledby="ds"><div class="wrap">
  <h2 class="sm" id="ds" style="margin-bottom: 28px">Descriptions</h2>
  <div class="desc">{descs.map(([k, text]) => (
    <div class="box"><p class="k">{k}</p><p data-text>{text}</p><button class="copybtn" type="button" style="align-self: flex-start" data-copy-from="[data-text]" aria-label={`Copy the ${k.split(' ·')[0].toLowerCase()} description`}>Copy</button></div>
  ))}</div>
  <p class="small" role="status" aria-live="polite" style="min-height: 22px; margin: 12px 0 0" data-status></p>
</div></section>
<section class="sec deep" aria-labelledby="as"><div class="wrap">
  <h2 class="sm" id="as" style="margin-bottom: 28px">Icon and screenshots</h2>
  <div class="row" style="gap: 32px; align-items: center; margin-bottom: 40px">
    <img class="iconimg" src="/icon.png" alt="The GitLoom app icon" width="128" height="128" />
    <div><p style="margin: 0 0 12px">The app icon, 1024 px PNG.</p><a class="btn btn-s" href="/press/gitloom-icon-1024.png" download><Fragment set:html={dl} />Download icon</a></div>
  </div>
  <div class="shots">{shots.flatMap(([n, label]) => ['light', 'dark'].map((th) => (
    <figure><img src={`/shots/${n}-${th}.png`} alt={`${label}, ${th} theme.`} width="1256" height="795" loading="lazy" />
      <figcaption><span>{label} · {th}</span><a href={`/shots/${n}-${th}.png`} download={`gitloom-${n}-${th}.png`}>PNG</a></figcaption></figure>
  )))}</div>
</div></section>
<section class="sec cream" aria-labelledby="co"><div class="wrap">
  <h2 class="sm" id="co" style="margin-bottom: 28px">Colours</h2>
  <div class="sw">{colours.map(([n, hex, use]) => <div><i style={`background: ${hex}`}></i><p><b>{n}</b><code>{hex}</code><br />{use}</p></div>)}</div>
</div></section>
<section class="sec cream" style="padding-top: 0" aria-labelledby="lo"><div class="wrap">
  <h2 class="sm" id="lo" style="margin-bottom: 28px">Using the icon</h2>
  <div class="dd">
    <div class="col"><h3>Do</h3><ul><li>Use the icon exactly as supplied.</li><li>Place it on cream, white or dark backgrounds.</li><li>Leave clear space around it.</li><li>Write the name as GitLoom, one word, capital G and L.</li></ul></div>
    <div class="col no"><h3>Don’t</h3><ul><li>Redraw, trace or simplify the bird or nest.</li><li>Recolour it or change the blue squircle.</li><li>Add shadows, glows, outlines or 3D effects.</li><li>Crop, rotate or put it on a busy photo.</li></ul></div>
  </div>
</div></section>
<section class="sec deep" aria-labelledby="fs"><div class="wrap">
  <h2 class="sm" id="fs" style="margin-bottom: 28px">Fact sheet</h2>
  <div class="tblw"><table class="tbl"><tbody>
    {facts.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
    <tr><th scope="row">Get it</th><td><a href="/download/">gitloom-site.vercel.app/download</a></td></tr>
    <tr><th scope="row">Latest version</th><td>{latest ? `${latest.version} · ${formatDate(latest.date)}` : 'First release coming soon'}</td></tr>
  </tbody></table></div>
  <p style="margin: 32px 0 0">Press questions: open an issue on <a href="https://github.com/Jarvis219/gitloom-site/issues">GitHub Issues</a>.</p>
</div></section>
</Page>
