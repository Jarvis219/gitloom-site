---
import DocsArticle from '../../views/DocsArticle.astro';
import { locales } from '../../i18n/locales';
import { docsFor } from '../../lib/docs';

export function getStaticPaths() {
  return docsFor(locales[0]).map((d) => ({ params: { slug: d.slug } }));
}
---
<DocsArticle locale={locales[0]} slug={Astro.params.slug!} />
