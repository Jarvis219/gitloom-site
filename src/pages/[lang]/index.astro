---
import Home from '../../components/Home.astro';
import { locales, localeByPath } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.filter((l) => l.path).map((l) => ({ params: { lang: l.path } }));
}
const locale = localeByPath(Astro.params.lang);
---
<Home locale={locale} />
