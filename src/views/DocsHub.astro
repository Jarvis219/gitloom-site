---
import Page from '../layouts/Page.astro';
import SearchBox from '../components/SearchBox.astro';
import type { Locale } from '../i18n/locales';
import { pagesCopy } from '../i18n/pages';
import { docsFor, byGroupFor } from '../lib/docs';

interface Props { locale: Locale }
const { locale } = Astro.props;
const all = pagesCopy(locale.code);
const t = all.docs;
const docs = docsFor(locale);
const start = ['install', 'first-steps', 'the-window'].map((s) => docs.find((d) => d.slug === s)!).filter(Boolean);
const groupName = (g: string) => t.groups[g as keyof typeof t.groups] ?? g;
---
<Page locale={locale} title={t.metaTitle} description={t.metaDescription} path="/docs/" current="docs" crumbs={[{ name: t.eyebrow, path: '/docs/' }]}>
<section class="pagehead cream"><div class="wrap">
  <p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1>
  <p class="lead">{t.lead}</p>
  <div style="margin-top: 32px"><SearchBox id="q" label={all.search.docs} locale={locale} /></div>
</div></section>
<section class="sec cream" style="padding-top: 24px" aria-labelledby="sh"><div class="wrap">
  <h2 class="sm" id="sh" style="margin-bottom: 28px">{t.startHere}</h2>
  <ol class="start">{start.map((d, i) => <li><a href={d.url}><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{d.title}</h3><p>{d.summary}</p></a></li>)}</ol>
</div></section>
<section class="sec deep" aria-labelledby="ti"><div class="wrap">
  <h2 class="sm" id="ti" style="margin-bottom: 40px">{t.allTopics}</h2>
  <div class="index">{byGroupFor(locale).map((g) => (
    <section aria-labelledby={`g-${g.id}`}><h3 id={g.id}><span id={`g-${g.id}`}>{groupName(g.group)}</span></h3>
      <ul>{g.items.map((d) => <li><a href={d.url}>{d.title}</a></li>)}</ul></section>
  ))}</div>
</div></section>
</Page>
