---
import Page from '../layouts/Page.astro';
import type { Locale } from '../i18n/locales';
import { lp, formatDate } from '../i18n/paths';
import { pagesCopy } from '../i18n/pages';
import { docsFor, byGroupFor, groupId } from '../lib/docs';

interface Props { locale: Locale; slug: string }
const { locale, slug } = Astro.props;
const all = pagesCopy(locale.code);
const t = all.docs;
const docs = docsFor(locale);
const doc = docs.find((d) => d.slug === slug)!;
const i = docs.indexOf(doc);
const prev = docs[i - 1], next = docs[i + 1];
const html = await doc.html({ note: all.common.note, caution: all.common.caution, copy: all.common.copy, copyCode: all.common.copyCode });
const site = Astro.site ?? new URL('https://gitloom-site.vercel.app');
const groupName = (g: string) => t.groups[g as keyof typeof t.groups] ?? g;
const issue = `https://github.com/Jarvis219/gitloom-site/issues/new?labels=docs&title=${encodeURIComponent(`Docs (${locale.code}): ${doc.title}`)}`;
const ld = [{
  '@type': 'TechArticle',
  headline: doc.title,
  description: doc.summary,
  dateModified: doc.updated,
  inLanguage: doc.translated || locale.code === 'en' ? locale.hreflang : 'en',
  url: new URL(doc.url, site).href,
  about: { '@type': 'SoftwareApplication', name: 'GitLoom', operatingSystem: 'macOS 14 or later' },
  isPartOf: { '@type': 'WebSite', name: 'GitLoom', url: new URL('/', site).href },
}];
const sideNav = byGroupFor(locale);
const path = `/docs/${slug}/`;
---
<Page locale={locale} title={`${doc.title}${t.titleSuffix}`} description={doc.summary} path={path} current="docs" ld={ld} ogType="article"
  crumbs={[{ name: t.eyebrow, path: '/docs/' }, { name: doc.title, path }]}>
<div class="docs">
  <nav class="side" aria-label={t.eyebrow}>{sideNav.map((g) => (<>
    <p class="grp">{groupName(g.group)}</p>
    <ul>{g.items.map((d) => <li><a href={d.url} aria-current={d.slug === doc.slug ? 'page' : undefined}>{d.title}</a></li>)}</ul>
  </>))}</nav>
  <article class="art" aria-labelledby="t" lang={doc.translated || locale.code === 'en' ? undefined : 'en'}>
    <div class="docbar">
      <button class="btn btn-s menu-btn" type="button" aria-haspopup="dialog" data-sheet-open><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h11"></path></svg>&nbsp;{t.menu}</button>
      {doc.headings.length > 0 && <details><summary>{all.common.onThisPage} <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4.5l3 3 3-3"></path></svg></summary>
        <ul class="dd-list">{doc.headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}
    </div>
    <p class="crumbs"><a href={lp(locale, '/docs/')}>{t.eyebrow}</a><span aria-hidden="true">/</span><a href={`${lp(locale, '/docs/')}#${groupId(doc.group)}`}>{groupName(doc.group)}</a></p>
    <h1 id="t">{doc.title}</h1>
    <p class="updated">{all.common.lastUpdated} <time datetime={doc.updated}>{formatDate(doc.updated, locale)}</time><a href={issue}>{t.reportIssue}</a></p>
    <div class="prose" set:html={html} />
    <p class="small" role="status" aria-live="polite" style="min-height: 22px; margin-top: 8px" data-status></p>
    <nav class="pn" aria-label={t.previousNext}>
      {prev ? <a href={prev.url} rel="prev"><span>{t.previous}</span><b>{prev.title}</b></a> : <span></span>}
      {next && <a href={next.url} rel="next"><span>{t.next}</span><b>{next.title}</b></a>}
    </nav>
  </article>
  <aside class="toc" aria-label={all.common.onThisPage}>{doc.headings.length > 0 && <div class="in" data-toc><p>{all.common.onThisPage}</p>
    <ul>{doc.headings.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></div>}</aside>
</div>
<dialog class="sheet" aria-label={t.menu} data-sheet>
  <div class="sheet-head"><p class="fh" style="margin: 0">{t.eyebrow}</p><button class="btn btn-s btn-c" type="button" data-sheet-close>{t.close}</button></div>
  <nav class="side" aria-label={t.eyebrow}>{sideNav.map((g) => (<>
    <p class="grp">{groupName(g.group)}</p>
    <ul>{g.items.map((d) => <li><a href={d.url} aria-current={d.slug === doc.slug ? 'page' : undefined}>{d.title}</a></li>)}</ul>
  </>))}</nav>
</dialog>
</Page>

<script>
  // Mobile "Docs menu": a modal sheet (focus stays inside, Esc closes, focus returns to the button).
  const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]');
  const opener = document.querySelector<HTMLButtonElement>('[data-sheet-open]');
  opener?.addEventListener('click', () => { sheet?.showModal(); sheet?.querySelector<HTMLElement>('[aria-current]')?.scrollIntoView({ block: 'center' }); });
  sheet?.querySelector('[data-sheet-close]')?.addEventListener('click', () => sheet.close());
  sheet?.addEventListener('close', () => opener?.focus());
  sheet?.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
</script>
