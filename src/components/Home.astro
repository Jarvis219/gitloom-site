---
import Base from '../layouts/Base.astro';
import { locales, type Locale } from '../i18n/locales';
import { strings, linkText } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale.code];
const links = linkText[locale.code];
const download = 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg';
const releases = 'https://github.com/Jarvis219/gitloom-site/releases';
const home = (l: Locale) => (l.path ? `/${l.path}/` : '/');
const fill = (html: string) => html
  .replace('{download}', `<a href="${download}">${links.download}</a>`)
  .replace('{releases}', `<a href="${releases}">${links.releases}</a>`);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale.hreflang,
  mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base locale={locale} title={t.title} description={t.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={home(locale)}><img src="/favicon.png" width="28" height="28" alt="" />GitLoom</a>
      <nav>
        <a class="hide-sm" href="#features">{t.nav.features}</a>
        <a class="hide-sm" href="#install">{t.nav.install}</a>
        <a class="hide-sm" href="#faq">{t.nav.faq}</a>
        <details class="lang">
          <summary aria-label={t.language}>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
            {locale.name}
          </summary>
          <ul>
            {locales.map((l) => (
              <li><a href={home(l)} hreflang={l.hreflang} lang={l.hreflang} aria-current={l === locale ? 'page' : undefined}>{l.name}</a></li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <img class="icon" src="/icon.png" width="112" height="112" alt={t.iconAlt} />
      <h1>{t.heroTitle}</h1>
      <p class="lead">{t.heroLead}</p>
      <div class="cta">
        <a class="button" href={download}>{t.download}</a>
        <span class="note">{t.note}</span>
      </div>
      <figure class="shot">
        <img src="/screenshot.png" width="1256" height="795" alt={t.shotAlt} />
      </figure>
    </section>

    <section id="features" class="wrap">
      <h2>{t.featuresHeading}</h2>
      <div class="grid">
        {t.features.map(([title, body]) => (
          <article class="card">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="install" class="wrap">
      <h2>{t.installHeading}</h2>
      <ol class="steps">
        {t.steps.map((step) => <li set:html={fill(step)} />)}
      </ol>
      <p class="muted" set:html={fill(t.more)} />
    </section>

    <section id="faq" class="wrap">
      <h2>{t.faqHeading}</h2>
      {t.faq.map(([q, a]) => (
        <details class="qa">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  </main>

  <footer class="wrap foot">
    <span>GitLoom</span>
    <a href={releases}>{t.nav.releases}</a>
  </footer>
</Base>

<style>
  .top { position: sticky; top: 0; z-index: 2; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 56px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 700; color: var(--text); text-decoration: none; }
  nav { display: flex; align-items: center; gap: 18px; font-size: 15px; }
  nav > a { color: var(--muted); text-decoration: none; }
  nav > a:hover { color: var(--text); }
  .lang { position: relative; }
  .lang summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; color: var(--muted); padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; white-space: nowrap; }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary:hover, .lang[open] summary { color: var(--text); border-color: var(--slate); }
  .lang ul { position: absolute; inset-inline-end: 0; top: calc(100% + 8px); margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 16px 40px var(--shadow); max-height: 70vh; overflow: auto; min-width: 200px; }
  .lang li a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--text); text-decoration: none; }
  .lang li a:hover { background: var(--chip); }
  .lang li a[aria-current='page'] { color: var(--navy); background: var(--amber); font-weight: 600; }

  main { overflow-x: clip; }   /* the hero glow reaches past the edges */
  .hero { position: relative; text-align: center; padding-top: 64px; isolation: isolate; }
  .hero::before {
    content: ''; position: absolute; z-index: -1; inset: -40px -10% auto; height: 620px; pointer-events: none;
    background:
      radial-gradient(40% 55% at 30% 30%, var(--glow-a), transparent 70%),
      radial-gradient(35% 50% at 72% 25%, var(--glow-b), transparent 70%);
    filter: blur(8px);
  }
  .icon { display: block; margin: 0 auto 14px; filter: drop-shadow(0 12px 24px var(--shadow)); }
  h1 { font-size: clamp(36px, 6.4vw, 60px); line-height: 1.12; margin: 8px 0 16px; letter-spacing: -0.025em; }
  .lead { font-size: clamp(17px, 2.2vw, 20px); color: var(--muted); max-width: 660px; margin: 0 auto; }
  .cta { display: flex; flex-direction: column; align-items: center; gap: 12px; margin: 30px 0 44px; }
  .button {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--button); color: var(--button-text); text-decoration: none; font-weight: 700;
    padding: 13px 28px; border-radius: 999px; font-size: 17px;
    box-shadow: 0 10px 24px rgb(246 177 122 / 0.35), inset 0 -2px 0 rgb(45 50 80 / 0.12);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .button:hover { transform: translateY(-1px); box-shadow: 0 14px 30px rgb(246 177 122 / 0.45), inset 0 -2px 0 rgb(45 50 80 / 0.12); }
  .button:focus-visible, a:focus-visible, summary:focus-visible { outline: 3px solid var(--slate); outline-offset: 3px; }
  .note, .muted { color: var(--muted); font-size: 14px; }
  .shot { margin: 0; padding: 10px; border-radius: 18px; background: linear-gradient(135deg, var(--slate), var(--indigo) 45%, var(--amber)); box-shadow: 0 30px 70px var(--shadow); }
  .shot img { display: block; border-radius: 10px; }

  section { padding: 44px 16px; }
  h2 { font-size: clamp(25px, 3.6vw, 34px); margin: 24px 0 22px; letter-spacing: -0.015em; }
  h2::after { content: ''; display: block; width: 44px; height: 4px; margin-top: 10px; border-radius: 4px; background: var(--amber); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .card { position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px 20px 18px; transition: border-color 0.15s ease, transform 0.15s ease; }
  .card::before { content: ''; position: absolute; inset-block-start: 0; inset-inline: 20px; height: 3px; border-radius: 0 0 3px 3px; background: linear-gradient(90deg, var(--slate), var(--amber)); opacity: 0.85; }
  .card:hover { border-color: var(--slate); transform: translateY(-2px); }
  .card h3 { margin: 4px 0 6px; font-size: 17px; }
  .card p { margin: 0; color: var(--muted); font-size: 15px; }

  .steps { list-style: none; counter-reset: step; padding: 0; margin: 0; display: grid; gap: 12px; }
  /* Not flex: <strong>/<a> inside a step would become separate flex items with gaps around them. */
  .steps li { counter-increment: step; position: relative; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; padding-inline-start: 60px; min-height: 56px; }
  .steps li::before { content: counter(step); position: absolute; inset-inline-start: 18px; top: 14px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: var(--amber); color: var(--navy); font-weight: 700; font-size: 14px; }
  .muted { margin-top: 16px; }

  .qa { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 14px 18px; margin: 10px 0; }
  .qa[open] { border-color: var(--slate); }
  .qa summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after { content: '+'; color: var(--amber); font-size: 20px; line-height: 1; font-weight: 700; }
  .qa[open] summary::after { content: '−'; }
  .qa p { margin: 10px 0 0; color: var(--muted); }

  .foot { display: flex; justify-content: space-between; padding: 28px 16px 40px; color: var(--muted); font-size: 14px; border-top: 1px solid var(--line); }
  @media (max-width: 640px) { .hide-sm { display: none; } .shot { padding: 6px; border-radius: 14px; } }
  @media (prefers-reduced-motion: reduce) { .button, .card { transition: none; } .button:hover, .card:hover { transform: none; } }
</style>
