---
import Base from '../layouts/Base.astro';
import { locales, type Locale } from '../i18n/locales';
import { strings, linkText } from '../i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale.code];
const links = linkText[locale.code];
const download = 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg';
const releases = 'https://github.com/Jarvis219/gitloom-site/releases';
const home = (l: Locale) => (l.path ? `/${l.path}/` : '/');
const fill = (html: string) => html
  .replace('{download}', `<a href="${download}">${links.download}</a>`)
  .replace('{releases}', `<a href="${releases}">${links.releases}</a>`);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: locale.hreflang,
  mainEntity: t.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<Base locale={locale} title={t.title} description={t.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <header class="top">
    <div class="wrap bar">
      <a class="brand" href={home(locale)}><img src="/favicon.png" width="28" height="28" alt="" />GitLoom</a>
      <nav>
        <a class="hide-sm" href="#features">{t.nav.features}</a>
        <a class="hide-sm" href="#install">{t.nav.install}</a>
        <a class="hide-sm" href="#faq">{t.nav.faq}</a>
        <details class="lang">
          <summary aria-label={t.language}>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
            {locale.name}
          </summary>
          <ul>
            {locales.map((l) => (
              <li><a href={home(l)} hreflang={l.hreflang} lang={l.hreflang} aria-current={l === locale ? 'page' : undefined}>{l.name}</a></li>
            ))}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero wrap">
      <img class="icon" src="/icon.png" width="112" height="112" alt={t.iconAlt} />
      <h1>{t.heroTitle}</h1>
      <p class="lead">{t.heroLead}</p>
      <div class="cta">
        <a class="button" href={download}>{t.download}</a>
        <span class="note">{t.note}</span>
      </div>
      <figure class="shot">
        <img src="/screenshot.png" width="1256" height="795" alt={t.shotAlt} />
      </figure>
    </section>

    <section id="features" class="wrap">
      <h2>{t.featuresHeading}</h2>
      <div class="grid">
        {t.features.map(([title, body]) => (
          <article class="card">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="install" class="wrap">
      <h2>{t.installHeading}</h2>
      <ol class="steps">
        {t.steps.map((step) => <li set:html={fill(step)} />)}
      </ol>
      <p class="muted" set:html={fill(t.more)} />
    </section>

    <section id="faq" class="wrap">
      <h2>{t.faqHeading}</h2>
      {t.faq.map(([q, a]) => (
        <details class="qa">
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>
  </main>

  <footer class="wrap foot">
    <span>GitLoom</span>
    <a href={releases}>{t.nav.releases}</a>
  </footer>
</Base>

<style>
  .top { position: sticky; top: 0; z-index: 2; background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 56px; }
  .brand { display: flex; align-items: center; gap: 8px; font-weight: 650; color: var(--text); text-decoration: none; }
  nav { display: flex; align-items: center; gap: 18px; font-size: 15px; }
  nav > a { color: var(--muted); text-decoration: none; }
  nav > a:hover { color: var(--text); }
  .lang { position: relative; }
  .lang summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; color: var(--muted); padding: 4px 8px; border: 1px solid var(--line); border-radius: 8px; white-space: nowrap; }
  .lang summary::-webkit-details-marker { display: none; }
  .lang[open] summary { color: var(--text); }
  .lang ul { position: absolute; inset-inline-end: 0; top: calc(100% + 6px); margin: 0; padding: 6px; list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 30px rgb(0 0 0 / 0.18); max-height: 70vh; overflow: auto; min-width: 190px; }
  .lang li a { display: block; padding: 6px 10px; border-radius: 6px; color: var(--text); text-decoration: none; }
  .lang li a:hover { background: var(--code); }
  .lang li a[aria-current='page'] { color: var(--accent); font-weight: 600; }
  .hero { text-align: center; padding-top: 56px; }
  .icon { display: block; margin: 0 auto 12px; }
  h1 { font-size: clamp(34px, 6vw, 56px); line-height: 1.15; margin: 8px 0 14px; letter-spacing: -0.02em; }
  .lead { font-size: clamp(17px, 2.2vw, 20px); color: var(--muted); max-width: 660px; margin: 0 auto; }
  .cta { display: flex; flex-direction: column; align-items: center; gap: 10px; margin: 28px 0 40px; }
  .button { background: var(--accent); color: var(--accent-text); text-decoration: none; font-weight: 600; padding: 12px 26px; border-radius: 10px; font-size: 17px; }
  .button:hover { filter: brightness(1.08); }
  .note, .muted { color: var(--muted); font-size: 14px; }
  .shot { margin: 0; }
  .shot img { border-radius: 12px; border: 1px solid var(--line); box-shadow: 0 24px 60px rgb(0 0 0 / 0.25); }
  section { padding: 40px 16px; }
  h2 { font-size: clamp(24px, 3.4vw, 32px); margin: 24px 0 20px; letter-spacing: -0.01em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 16px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; }
  .card h3 { margin: 0 0 6px; font-size: 17px; }
  .card p { margin: 0; color: var(--muted); font-size: 15px; }
  .steps { padding-inline-start: 22px; }
  .steps li { margin: 8px 0; }
  .qa { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px; margin: 10px 0; }
  .qa summary { cursor: pointer; font-weight: 600; }
  .qa p { margin: 8px 0 0; color: var(--muted); }
  .foot { display: flex; justify-content: space-between; padding: 28px 16px 40px; color: var(--muted); font-size: 14px; border-top: 1px solid var(--line); }
  @media (max-width: 640px) { .hide-sm { display: none; } }
</style>
