---
import Base from '../layouts/Base.astro';
import SiteNav from './SiteNav.astro';
import SiteFooter from './SiteFooter.astro';
import { locales, type Locale } from '../i18n/locales';
import { landingCopy } from '../i18n/landing';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/landing.css';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = landingCopy(locale.code);
const dmg = 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg';
// Real screenshots (light/dark) and the crops the design uses for each chapter.
const shots = ['graph', 'conflict', 'diff', 'graph', 'graph'];
const crops: (string | null)[] = [
  'aspect-ratio: 664 / 520|width: 189.16%; margin-left: -34.94%; margin-top: -17.02%',
  null,
  null,
  'aspect-ratio: 668 / 230|width: 188.02%; margin-left: -34.73%; margin-top: -7.78%',
  'aspect-ratio: 496 / 300|width: 253.23%; margin-left: -153.23%; margin-top: 0%',
];
const chapterClass = ['cream', 'deep flip', 'cream', 'band flip', 'cream'];
---
<Base locale={locale} title={t.title} description={t.description} imageAlt={t.heroAlt}
  features={[...t.chapters.flatMap((c) => c.facts.filter((f) => !f.includes('<'))), ...t.gh.facts, ...t.ai.facts.map((f) => f.replace(/<[^>]+>/g, ''))]}>
<Fragment slot="head">
  <link rel="preload" as="image" href="/shots/graph-light.png" media="(prefers-color-scheme: light)" fetchpriority="high" />
  <link rel="preload" as="image" href="/shots/graph-dark.png" media="(prefers-color-scheme: dark)" fetchpriority="high" />
</Fragment>
<div class="gl">
<SiteNav locale={locale} current="home" />

<main id="main">
<section class="hero cream" aria-labelledby="h1"><div class="wrap">
  <div class="copy reveal">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 id="h1">{t.h1}</h1>
    <p class="lead">{t.lead}</p>
    <div class="row" style="margin-top: 36px">
      <a class="btn btn-p" href={dmg}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v9M4 7.5l4 4 4-4M2.5 14h11"></path></svg>{t.download}</a>
      <a class="btn btn-s" href="#drag">{t.seeIt}</a>
    </div>
    <p class="meta">{t.meta}</p>
  </div>
  <div class="pic reveal" data-parallax>
    <figure class="win"><div class="shot">
      <picture><source media="(prefers-color-scheme: dark)" srcset="/shots/graph-dark.png" /><img src="/shots/graph-light.png" alt={t.heroAlt} width="1256" height="795" fetchpriority="high" /></picture>
      <span class="ghost" aria-hidden="true">feature/sync-engine</span>
      <div class="menu" aria-hidden="true"><div>{t.heroMenu[0]}</div><div class="on">{t.heroMenu[1]}</div><div class="sep"></div><div>{t.heroMenu[2]}</div></div>
      <svg class="cursor" viewBox="0 0 18 22" aria-hidden="true"><path d="M1.5 1.5v16.2l4.3-4.1 2.9 6.6 2.9-1.3-2.9-6.5h6.1z" fill="#16161A" stroke="#FFFFFF" stroke-width="1.4" stroke-linejoin="round"></path></svg>
    </div><figcaption>{t.heroCaption}</figcaption></figure>
  </div>
</div></section>

<section class="proof band" aria-label={t.proofLabel}><div class="wrap">
  <div class="figs">
    {t.figs.map(([n, label], i) => <div class="fig reveal" style={`--d:${i * 80}ms`}><span class="num" dir="ltr" data-count={n}>{n}</span><p>{label}</p></div>)}
  </div>
</div></section>

{t.chapters.map((c, i) => {
  const crop = crops[i]?.split('|');
  const shot = shots[i];
  return (
  <section class={`sec ch ${chapterClass[i]}`} id={c.id} aria-labelledby={`c${i + 1}`}><div class="wrap">
    <div class="txt reveal">
      <p class="eyebrow">{c.eyebrow}</p><h2 id={`c${i + 1}`}>{c.title}</h2><p class="lead">{c.lead}</p>
      <ul class="facts">{c.facts.map((f, j) => <li class="reveal" style={`--d:${120 + j * 70}ms`}><span>{String(j + 1).padStart(2, '0')}</span><span class="f" set:html={f} /></li>)}</ul>
    </div>
    <div class="pic reveal" data-parallax><figure class="win"><div class="shot">
      {crop ? (
        <div class="crop" style={crop[0]}><picture><source media="(prefers-color-scheme: dark)" srcset={`/shots/${shot}-dark.png`} /><img src={`/shots/${shot}-light.png`} alt={c.alt} style={crop[1]} loading="lazy" /></picture></div>
      ) : (
        <picture><source media="(prefers-color-scheme: dark)" srcset={`/shots/${shot}-dark.png`} /><img src={`/shots/${shot}-light.png`} alt={c.alt} width="1256" height="795" loading="lazy" /></picture>
      )}
    </div><figcaption>{c.caption}</figcaption></figure></div>
  </div></section>
  );
})}

<section class="sec deep" aria-labelledby="gh"><div class="wrap">
  <div class="gh-head">
    <div class="a reveal"><p class="eyebrow">{t.gh.eyebrow}</p><h2 id="gh">{t.gh.title}</h2><p class="lead">{t.gh.lead}</p></div>
    <div class="b reveal" style="--d:100ms"><ul class="facts">{t.gh.facts.map((f, j) => <li><span>{String(j + 1).padStart(2, '0')}</span>{f}</li>)}</ul></div>
  </div>
  <figure class="win reveal" data-parallax><div class="shot"><picture><source media="(prefers-color-scheme: dark)" srcset="/shots/actions-dark.png" /><img src="/shots/actions-light.png" alt={t.gh.alt} width="1256" height="795" loading="lazy" /></picture></div><figcaption>{t.gh.caption}</figcaption></figure>
</div></section>

<section class="sec ch band" id="ai" aria-labelledby="aih"><div class="wrap">
  <div class="txt reveal">
    <p class="eyebrow">{t.ai.eyebrow}</p><h2 id="aih">{t.ai.title}</h2><p class="lead">{t.ai.lead}</p>
    <ul class="facts">{t.ai.facts.map((f, j) => <li class="reveal" style={`--d:${120 + j * 70}ms`}><span>{String(j + 1).padStart(2, '0')}</span><span class="f" set:html={f} /></li>)}</ul>
    <p class="small" style="margin: 20px 0 0">{t.ai.privacy}</p>
  </div>
  <div class="pic reveal" data-parallax><figure class="win"><div class="shot">
    <div class="crop" style="aspect-ratio: 696 / 650"><picture><source media="(prefers-color-scheme: dark)" srcset="/shots/ai-dark.png" /><img src="/shots/ai-light.png" alt={t.ai.alt} style="width: 180.5%; margin-left: -80.5%; margin-top: -15.8%" loading="lazy" /></picture></div>
  </div><figcaption>{t.ai.caption}</figcaption></figure>
  <p class="small" style="margin: 20px 0 0">{t.ai.mcp}</p></div>
</div></section>

<section class="sec cream" aria-labelledby="pw"><div class="wrap power">
  <div class="h reveal"><p class="eyebrow">{t.power.eyebrow}</p><h2 class="sm" id="pw">{t.power.title}</h2></div>
  <dl>{t.power.items.map(([k, v], i) => <div class="reveal" style={`--d:${(i % 2) * 60 + Math.floor(i / 2) * 50}ms`}><dt set:html={k} /><dd>{v}</dd></div>)}</dl>
</div></section>

<section class="sec band langs" aria-labelledby="lg"><div class="wrap">
  <div class="txt reveal"><p class="eyebrow">{t.langs.eyebrow}</p><h2 id="lg">{t.langs.title}</h2>
    <p class="lead">{t.langs.lead}</p>
    <ul class="names">{locales.map((l, i) => <li lang={l.hreflang} dir={l.dir} class="reveal" style={`--d:${i * 30}ms`}>{l.name}</li>)}</ul></div>
  <div class="pic reveal" data-parallax><figure class="win"><div class="shot split" data-split>
    <img src="/shots/graph-light.png" alt={t.langs.alt} width="1256" height="795" loading="lazy" />
    <div class="dk" aria-hidden="true"><img src="/shots/graph-dark.png" alt="" loading="lazy" /></div><span class="seam" aria-hidden="true"></span>
  </div><figcaption>{t.langs.caption}</figcaption></figure></div>
</div></section>

<section class="sec cream" id="in" aria-labelledby="inh"><div class="wrap">
  <div class="reveal"><p class="eyebrow">{t.install.eyebrow}</p><h2 id="inh">{t.install.title}</h2></div>
  <ol class="steps">
    <li class="reveal" style="--d:0ms"><a class="cap" href={dmg} aria-label={t.download}><div class="row2"><span class="tile"><img src="/icon.png" alt="" />{t.install.art.dmg}</span><span class="arrow">→</span><span class="tile"><span class="folder"></span>{t.install.art.apps}</span></div></a>
      <span class="stepn">{t.install.steps[0].n}</span><h3>{t.install.steps[0].title}</h3><p>{t.install.steps[0].text}</p></li>
    <li class="reveal" style="--d:100ms"><div class="cap" aria-hidden="true"><div class="dlg"><b>{t.install.art.dialogTitle}</b><span>{t.install.art.dialogText}</span><span class="pill">{t.install.art.done}</span></div></div>
      <span class="stepn">{t.install.steps[1].n}</span><h3>{t.install.steps[1].title}</h3><p>{t.install.steps[1].text}</p></li>
    <li class="reveal" style="--d:200ms"><div class="cap" aria-hidden="true"><div class="dlg"><b>{t.install.art.pane}</b><span>{t.install.art.paneText}</span><span class="pill">{t.install.art.openAnyway}</span></div></div>
      <span class="stepn">{t.install.steps[2].n}</span><h3>{t.install.steps[2].title}</h3><p>{t.install.steps[2].text}</p></li>
  </ol>
  <div class="honest reveal">
    <div class="a"><p style="margin: 0; font-size: 16px">{t.install.honest}</p></div>
    <div class="b"><p class="small" style="margin: 0 0 10px">{t.install.terminal}</p>
      <div class="code"><pre><code data-cmd>curl -LO {dmg}</code></pre><button class="copybtn" type="button" data-copy data-done={t.install.copied}>{t.install.copy}</button></div>
      <p class="small" role="status" aria-live="polite" style="margin: 8px 0 0; min-height: 22px" data-status></p></div>
  </div>
</div></section>

<section class="sec band cta" aria-labelledby="ct"><div class="wrap">
  <div class="reveal"><span class="appicon"><img src="/icon.png" alt="" width="112" height="112" /></span><h2 id="ct">{t.cta.title}</h2><p class="lead">{t.cta.lead}</p></div>
  <div class="reveal" style="--d:120ms"><div class="row"><a class="btn btn-p" href={dmg}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v9M4 7.5l4 4 4-4M2.5 14h11"></path></svg>{t.download}</a><a class="btn btn-s" href="#in">{t.cta.guide}</a></div>
    <p class="meta">{t.meta}</p></div>
</div></section>
</main>

<SiteFooter locale={locale} onHome />
</div>

<script>
  // Progressive enhancements; the page reads fine without them.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Reveal on scroll, staggered by --d (content stays visible without JS: only .js hides it first).
  document.documentElement.classList.add('js');
  const items = document.querySelectorAll<HTMLElement>('.reveal');
  if (reduce || !('IntersectionObserver' in window)) items.forEach((el) => el.classList.add('in'));
  else {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    items.forEach((el) => io.observe(el));
  }
  // Count-up of the proof figures, once.
  if (!reduce) {
    const run = (el: HTMLElement) => {
      const text = el.dataset.count ?? '';
      const m = text.match(/^([\d.]+)(.*)$/);
      if (!m) return;
      const end = parseFloat(m[1]), dec = (m[1].split('.')[1] ?? '').length, start = performance.now(), dur = 900;
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / dur), e = 1 - Math.pow(1 - p, 3);
        el.textContent = (end * e).toFixed(dec) + m[2];
        if (p < 1) requestAnimationFrame(step); else el.textContent = text;
      };
      requestAnimationFrame(step);
    };
    const co = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { run(e.target as HTMLElement); co.unobserve(e.target); }
    }), { threshold: 0.6 });
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => co.observe(el));
  }
  // Subtle parallax on product shots (at most 24px) and a nav that tightens once scrolled.
  const shots = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      nav?.classList.toggle('scrolled', scrollY > 8);
      if (reduce) return;
      const h = innerHeight;
      for (const el of shots) {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > h) continue;
        const k = (r.top + r.height / 2 - h / 2) / h;
        el.style.setProperty('--py', `${(-k * 24).toFixed(1)}px`);
      }
    });
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  // Light/dark split: the seam follows the pointer.
  const split = document.querySelector<HTMLElement>('[data-split]');
  if (split) {
    split.addEventListener('pointermove', (e) => {
      const r = split.getBoundingClientRect();
      split.style.setProperty('--cut', `${Math.min(95, Math.max(5, ((e.clientX - r.left) / r.width) * 100))}%`);
    });
    split.addEventListener('pointerleave', () => split.style.removeProperty('--cut'));
  }
  // Mobile menu.
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  burger?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    burger.setAttribute('aria-expanded', String(open));
  });
  // Copy the Terminal command.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
  copy?.addEventListener('click', async () => {
    const cmd = document.querySelector('[data-cmd]')?.textContent ?? '';
    try { await navigator.clipboard.writeText(cmd); } catch { return; }
    const label = copy.textContent;
    copy.textContent = copy.dataset.done ?? 'Copied';
    const status = document.querySelector('[data-status]');
    if (status) status.textContent = copy.dataset.done ?? '';
    setTimeout(() => { copy.textContent = label; if (status) status.textContent = ''; }, 1600);
  });
</script>
</Base>
