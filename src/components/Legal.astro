---
// Privacy, Terms and Security (design G5): "In short" panel, numbered sections, a sticky list of
// sections on the left (a Sections dropdown on phones), and print styles in pages.css.
import type { Locale } from '../i18n/locales';
import { locales } from '../i18n/locales';
import { lp, formatDate } from '../i18n/paths';
import { pagesCopy } from '../i18n/pages';

interface Props {
  locale: Locale;
  path: string;
  eyebrow: string;
  title: string;
  updated: string;          // ISO date
  draft?: boolean;
  short: string[];
  sections: { id: string; title: string; html: string }[];
}
const { locale, path, eyebrow, title, updated, draft = false, short, sections } = Astro.props;
const c = pagesCopy(locale.code).common;
const chevron = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4.5l3 3 3-3"></path></svg>';
---
<section class="pagehead cream"><div class="wrap">
  {draft && <p class="draft">{c.draft}</p>}
  <p class="eyebrow">{eyebrow}</p><h1>{title}</h1>
  <p class="updated">{c.lastUpdated} <time datetime={updated}>{formatDate(updated, locale)}</time></p>
  {locale.code !== 'en' && <p class="small" style="margin: 12px 0 0; max-width: 66ch">{c.translationNote} <a href={lp(locales[0], path)} lang="en" hreflang="en">{c.englishVersion}</a></p>}
</div></section>
<div class="legal cream">
  <aside class="toc" aria-label={c.sections}><div class="in">
    <div data-toc><p>{c.onThisPage}</p><ol>{sections.map((s, i) => <li><a href={`#${s.id}`}>{i + 1}. {s.title}</a></li>)}</ol></div>
    <details><summary>{c.sections} <Fragment set:html={chevron} /></summary>
      <ol class="dd-list">{sections.map((s, i) => <li><a href={`#${s.id}`}>{i + 1}. {s.title}</a></li>)}</ol></details>
  </div></aside>
  <div>
    <div class="summary"><p class="k">{c.inShort}</p><ul>{short.map((s) => <li>{s}</li>)}</ul></div>
    {sections.map((s, i) => (
      <section aria-labelledby={s.id}><h2 id={s.id}><span class="no">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2><Fragment set:html={s.html} /></section>
    ))}
  </div>
</div>
