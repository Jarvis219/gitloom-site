---
// Top bar shared by the landing and every sub-page (design G1/G2: Features · Docs · Download · Support).
import { locales, type Locale } from '../i18n/locales';
import { landingCopy } from '../i18n/landing';
import { chromeWords } from '../i18n/chrome';
import { lp } from '../i18n/paths';

interface Props { locale: Locale; current?: 'home' | 'docs' | 'download' | 'support' | 'other'; path?: string }
// path: this page without the language prefix, so the language menu switches to the same page.
const { locale, current = 'other', path = '/' } = Astro.props;
const t = landingCopy(locale.code);
const w = chromeWords(locale.code);
const home = (l: Locale) => (l.path ? `/${l.path}/` : '/');
const features = current === 'home' ? '#features' : `${home(locale)}#features`;
const here = (k: string) => (current === k ? 'page' : undefined);
---
<a class="btn btn-p skip" href="#main">{t.skip}</a>
<header class="nav" data-nav><div class="wrap">
  <a class="logo" href={home(locale)} aria-label="GitLoom"><img src="/favicon.png" width="28" height="28" alt="" />GitLoom</a>
  <nav aria-label="Main">
    <a class="hide-m" href={features}>{t.nav.features}</a>
    <a class="hide-m" href={lp(locale, '/docs/')} aria-current={here('docs')}>{w.docs}</a>
    <a class="btn btn-p btn-c" href={lp(locale, '/download/')} aria-current={here('download')}>{t.nav.download}</a>
    <a class="hide-m" href={lp(locale, '/support/')} aria-current={here('support')}>{t.nav.support}</a>
    <details class="lang">
      <summary aria-label={`${t.language}: ${locale.name}`}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="6.3"></circle><path d="M1.8 8h12.4M8 1.7c1.8 1.9 2.6 4 2.6 6.3S9.8 12.4 8 14.3M8 1.7C6.2 3.6 5.4 5.7 5.4 8s.8 4.4 2.6 6.3"></path></svg>
        <span>{locale.name}</span>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4.5l3 3 3-3"></path></svg>
      </summary>
      <ul>{locales.map((l) => <li><a href={lp(l, path)} lang={l.hreflang} dir={l.dir} aria-current={l === locale ? 'true' : undefined}>{l.name}{l === locale && <span aria-hidden="true">✓</span>}</a></li>)}</ul>
    </details>
    <button class="burger" type="button" aria-label={t.nav.menu} aria-expanded="false" data-burger><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 5.5h12M3 12.5h12"></path></svg></button>
  </nav>
</div></header>
