---
import { locales, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Short feature names for the structured data (featureList). */
  features?: string[];
  /** Localized description of the share image. */
  imageAlt?: string;
  /** Sub-pages (English only): their own path. Leaves out the language alternates and the app's JSON-LD. */
  path?: string;
  /** Extra JSON-LD nodes for this page (FAQPage, TechArticle, BreadcrumbList…). */
  ld?: object[];
  /** 404 and search: keep out of search engines. */
  noindex?: boolean;
  ogType?: string;
}
const { locale, title, description, features = [], imageAlt = 'GitLoom commit graph on macOS', path, ld = [], noindex = false, ogType = 'website' } = Astro.props;
const site = Astro.site ?? new URL('https://gitloom-site.vercel.app');
const href = (l: Locale) => new URL(l.path ? `/${l.path}/` : '/', site).href;
const canonical = path ? new URL(path, site).href : href(locale);
const root = href(locales[0]);
const ogImage = new URL('/og.jpg', site).href;
const shot = (name: string) => new URL(`/shots/${name}-light.png`, site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${root}#website`,
      name: 'GitLoom',
      url: root,
      inLanguage: locales.map((l) => l.hreflang),
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${root}#app`,
      name: 'GitLoom',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Git client',
      operatingSystem: 'macOS 14 or later',
      softwareRequirements: 'macOS 14 Sonoma or later, Apple silicon',
      fileSize: '42MB',
      inLanguage: locale.hreflang,
      availableLanguage: locales.map((l) => l.hreflang),
      description,
      url: canonical,
      image: ogImage,
      screenshot: ['graph', 'diff', 'conflict', 'actions'].map(shot),
      ...(features.length ? { featureList: features } : {}),
      downloadUrl: 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg',
      releaseNotes: 'https://github.com/Jarvis219/gitloom-site/releases',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isPartOf: { '@id': `${root}#website` },
    },
  ].filter((n) => !path || n['@type'] === 'WebSite').concat(ld as never[]),
};
---
<!doctype html>
<html lang={locale.hreflang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {!path && locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={href(l)} />)}
    {!path && <link rel="alternate" hreflang="x-default" href={href(locales[0])} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#14110E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FBF4E8" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GitLoom" />
    <meta property="og:locale" content={locale.og} />
    {!path && locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <style is:global>
      /* Palette: Color Hunt #2D3250 · #424769 · #7077A1 · #F6B17A
         (https://colorhunt.co/palette/2d32504247697077a1f6b17a) — the icon's indigo and amber.
         Text pairs checked against WCAG AA; #7077A1 is decoration only (4.3:1 on white). */
      :root {
        --navy: #2D3250;
        --indigo: #424769;
        --slate: #7077A1;
        --amber: #F6B17A;
        --bg: #FBF4E8;
        --surface: #FFFFFF;
        --text: var(--navy);
        --muted: #555B86;
        --line: #E4E2EC;
        --link: var(--indigo);
        --button: var(--amber);
        --button-text: var(--navy);
        --glow-a: rgb(112 119 161 / 0.22);
        --glow-b: rgb(246 177 122 / 0.30);
        --chip: #EFEDF5;
        --shadow: rgb(45 50 80 / 0.18);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #14110E;
          --surface: #383D5E;
          --text: #F4F3F8;
          --muted: #C3C6DE;
          --line: #4A5075;
          --link: var(--amber);
          --button: var(--amber);
          --button-text: var(--navy);
          --glow-a: rgb(112 119 161 / 0.35);
          --glow-b: rgb(246 177 122 / 0.16);
          --chip: var(--indigo);
          --shadow: rgb(0 0 0 / 0.35);
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Noto Sans', sans-serif;
      }
      a { color: var(--link); text-underline-offset: 3px; }
      img { max-width: 100%; height: auto; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
