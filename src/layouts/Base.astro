---
interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(base + path, Astro.site).href;
const ogImage = new URL(base + 'og.jpg', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GitLoom',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 14 or later',
  description,
  url: new URL(base, Astro.site).href,
  image: ogImage,
  downloadUrl: 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={base + 'favicon.png'} />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'} />
    <link rel="sitemap" href={base + 'sitemap-index.xml'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GitLoom" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1256" />
    <meta property="og:image:height" content="795" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      :root {
        --bg: #f7f8fa;
        --surface: #ffffff;
        --text: #14161c;
        --muted: #5b6070;
        --line: #e3e6ec;
        --accent: #3b82f6;
        --accent-text: #ffffff;
        --code: #eef1f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1117;
          --surface: #171a22;
          --text: #eceef3;
          --muted: #9aa1b2;
          --line: #262a35;
          --accent: #4c8dff;
          --accent-text: #ffffff;
          --code: #1e222c;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif;
      }
      a { color: var(--accent); }
      img { max-width: 100%; height: auto; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
      code { background: var(--code); padding: 1px 6px; border-radius: 5px; font-size: 0.92em; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
