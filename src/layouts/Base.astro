---
import { locales, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}
const { locale, title, description } = Astro.props;
const site = Astro.site ?? new URL('https://gitloom-site.vercel.app');
const href = (l: Locale) => new URL(l.path ? `/${l.path}/` : '/', site).href;
const canonical = href(locale);
const ogImage = new URL('/og.jpg', site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'GitLoom',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 14 or later',
  inLanguage: locale.hreflang,
  description,
  url: canonical,
  image: ogImage,
  downloadUrl: 'https://github.com/Jarvis219/gitloom-site/releases/latest/download/GitLoom.dmg',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang={locale.hreflang} dir={locale.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l.hreflang} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href(locales[0])} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GitLoom" />
    <meta property="og:locale" content={locale.og} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={l.og} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1256" />
    <meta property="og:image:height" content="795" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <style is:global>
      :root {
        --bg: #f7f8fa;
        --surface: #ffffff;
        --text: #14161c;
        --muted: #5b6070;
        --line: #e3e6ec;
        --accent: #2f6fe0;
        --accent-text: #ffffff;
        --code: #eef1f6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0f1117;
          --surface: #171a22;
          --text: #eceef3;
          --muted: #9aa1b2;
          --line: #262a35;
          --accent: #4c8dff;
          --accent-text: #ffffff;
          --code: #1e222c;
        }
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Noto Sans', sans-serif;
      }
      a { color: var(--accent); }
      img { max-width: 100%; height: auto; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
